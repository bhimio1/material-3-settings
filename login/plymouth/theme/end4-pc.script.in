// end4-pC boot animation. Generated by login/plymouth/install.sh, which
// fills in the @…@ values from the rendered frames' palette.txt.

fps = @FPS@;
intro_count = @INTRO@;
loop_count = @LOOP@;

// Plymouth calls the refresh function 50 times a second.
REFRESH_HZ = 50;

fun hex(c) {
    return c / 255;
}

Window.SetBackgroundTopColor(hex(@BG_R@), hex(@BG_G@), hex(@BG_B@));
Window.SetBackgroundBottomColor(hex(@BG_R@), hex(@BG_G@), hex(@BG_B@));

screen_w = Window.GetWidth();
screen_h = Window.GetHeight();
// The emblem is about a quarter of the screen height.
size = Math.Int(screen_h * 0.26);

fun pad4(n) {
    s = "";
    if (n < 1000) s = "0";
    if (n < 100) s = s + "0";
    if (n < 10) s = s + "0";
    return s + n;
}

for (i = 0; i < intro_count; i++)
    intro[i] = Image("intro-" + pad4(i) + ".png").Scale(size, size);
for (i = 0; i < loop_count; i++)
    loop[i] = Image("loop-" + pad4(i) + ".png").Scale(size, size);

emblem = Sprite(intro[0]);
emblem.SetX(Math.Int((screen_w - size) / 2));
emblem.SetY(Math.Int((screen_h - size) / 2 - screen_h * 0.04));
emblem.SetZ(10);

ticks = 0;

fun refresh_callback() {
    ticks++;
    frame = Math.Int(ticks * fps / REFRESH_HZ);
    if (frame < intro_count) {
        emblem.SetImage(intro[frame]);
    } else {
        emblem.SetImage(loop[(frame - intro_count) % loop_count]);
    }
}
Plymouth.SetRefreshFunction(refresh_callback);

// ---------------------------------------------------------------- password

entry_image = Image("entry.png");
bullet_image = Image("bullet.png");
lock_image = Image("lock.png");

entry.sprite = Sprite(entry_image);
entry.x = Math.Int((screen_w - entry_image.GetWidth()) / 2);
entry.y = Math.Int(screen_h * 0.5 + size * 0.62);
entry.sprite.SetPosition(entry.x, entry.y, 20);
entry.sprite.SetOpacity(0);

lock.sprite = Sprite(lock_image);
lock.sprite.SetPosition(entry.x + 20, entry.y + Math.Int((entry_image.GetHeight() - lock_image.GetHeight()) / 2), 21);
lock.sprite.SetOpacity(0);

prompt.sprite = Sprite();
prompt.sprite.SetZ(21);

bullets = [];

fun hide_password() {
    entry.sprite.SetOpacity(0);
    lock.sprite.SetOpacity(0);
    prompt.sprite.SetOpacity(0);
    for (i = 0; bullets[i]; i++)
        bullets[i].SetOpacity(0);
}

fun display_password_callback(text, count) {
    entry.sprite.SetOpacity(1);
    lock.sprite.SetOpacity(1);

    if (!text) text = "Password";
    prompt_image = Image.Text(text, hex(@TEXT_R@), hex(@TEXT_G@), hex(@TEXT_B@), 0.8, "Sans 12");
    prompt.sprite.SetImage(prompt_image);
    prompt.sprite.SetPosition(Math.Int((screen_w - prompt_image.GetWidth()) / 2), entry.y - prompt_image.GetHeight() - 12, 21);
    prompt.sprite.SetOpacity(1);

    max = Math.Int((entry_image.GetWidth() - 84) / (bullet_image.GetWidth() + 8));
    shown = count;
    if (shown > max) shown = max;
    for (i = 0; i < shown; i++) {
        if (!bullets[i]) bullets[i] = Sprite(bullet_image);
        bullets[i].SetPosition(entry.x + 60 + i * (bullet_image.GetWidth() + 8),
                               entry.y + Math.Int((entry_image.GetHeight() - bullet_image.GetHeight()) / 2), 22);
        bullets[i].SetOpacity(1);
    }
    for (i = shown; bullets[i]; i++)
        bullets[i].SetOpacity(0);
}
Plymouth.SetDisplayPasswordFunction(display_password_callback);

fun display_normal_callback() {
    hide_password();
}
Plymouth.SetDisplayNormalFunction(display_normal_callback);

// ---------------------------------------------------------------- messages

message.sprite = Sprite();
message.sprite.SetZ(30);

fun message_callback(text) {
    image = Image.Text(text, hex(@TEXT_R@), hex(@TEXT_G@), hex(@TEXT_B@), 0.7, "Sans 11");
    message.sprite.SetImage(image);
    message.sprite.SetPosition(Math.Int((screen_w - image.GetWidth()) / 2), screen_h - image.GetHeight() - 48, 30);
}
Plymouth.SetMessageFunction(message_callback);
